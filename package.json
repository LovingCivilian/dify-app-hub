{
	"name": "ai-app-hub",
	"version": "0.8.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "PORT=5300 next dev",
		"build": "next build",
		"start": "next start",
		"dev:docs": "pnpm --filter ai-app-hub-docs dev",
