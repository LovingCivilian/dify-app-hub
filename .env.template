# Environment for the hub. Copy this file to .env and fill in the values.

# Database: PostgreSQL 18 in the hub's own container (ADR-0031). The compose files create the database from the three
# POSTGRES_* values on the volume's first start (the postgres image's docs, "Environment Variables"); the password must
# not be empty. DATABASE_URL reaches it by the service name `postgres` from the app container; for `pnpm dev` on the
# host, .env.development.local sets it to the same database on 127.0.0.1:5432. A password with characters such as @, :
# or / is percent-encoded in the URL.
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://hub:change-me@postgres:5432/hub

# next-auth's secret (a long random string)
NEXTAUTH_SECRET=xxx

# SMTP, for the inherited password-reset mail
# true to turn mail on; every SMTP_* key below is then required
SMTP_ENABLED=false
SMTP_SERVER=smtp.example.com
# 465 for implicit TLS, 587 for STARTTLS
SMTP_PORT=465
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
# Display name and address
MAIL_DEFAULT_SEND_FROM="Dify App Hub <noreply@example.com>"
# The hub's public URL, for the links in mails
APP_URL=https://your-domain.example.com

# Directory (LDAP) sign-in and sync, ADR-0029 and docs/ldap.md. Setting LDAP_URL turns it on; LDAP_ENCRYPTION,
# LDAP_BIND_DN, LDAP_BIND_PASSWORD and LDAP_USER_BASE_DN are then required. The defaults are Active Directory's.
# LDAP_URL=ldaps://dc.corp.example:636
# ldaps (with ldaps://), starttls or none (with ldap://); none sends passwords in clear
# LDAP_ENCRYPTION=ldaps
# PEM file with the CA that signed the directory's certificate; Node's trust store when unset
# LDAP_CA_FILE=/run/secrets/ldap-ca.pem
# LDAP_BIND_DN=CN=svc-hub,OU=Service Accounts,DC=corp,DC=example
# A value with a $ is single-quoted in .env, which Docker Compose reads (LDAP_BIND_PASSWORD='pa$word');
# for pnpm dev, put it as \$ in .env.development.local instead, which Next reads and expands $NAME in
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=DC=corp,DC=example
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
# LDAP_LOGIN_ATTRIBUTE=sAMAccountName
# LDAP_ID_ATTRIBUTE=objectGUID
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_NAME_ATTRIBUTE=displayName
# LDAP_USER_BASE_DN is used when unset
# LDAP_GROUP_BASE_DN=
# LDAP_GROUP_FILTER=(objectClass=group)
# LDAP_GROUP_NAME_ATTRIBUTE=cn
# LDAP_GROUP_MEMBER_FILTER=(memberOf:1.2.840.113556.1.4.1941:={group_dn})
# A five-field cron expression that fires, or off
# LDAP_SYNC_SCHEDULE=0 * * * *
# An IANA time zone name such as Asia/Riyadh (not an offset); the hub process's local zone when unset (croner's default; TZ sets it)
# LDAP_SYNC_TIMEZONE=

# Branding (docs/settings.md, ADR-0030). disabled: the built-in name and logo. env: the BRANDING_* values below.
# database: set on the admin page (Settings > Branding); the BRANDING_* values below are then ignored.
BRANDING_MODE=disabled
# BRANDING_NAME=Acme AI Hub
# true or false: the name beside the logo; false needs BRANDING_LOGO_FILE
# BRANDING_SHOW_NAME=true
# Image files inside the container, mounted read-only: PNG, JPEG or WebP, logo up to 512 KB, icon up to 256 KB
# BRANDING_LOGO_FILE=/branding/logo.png
# BRANDING_FAVICON_FILE=/branding/favicon.png
